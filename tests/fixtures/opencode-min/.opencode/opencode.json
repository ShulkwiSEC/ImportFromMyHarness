{
  // jsonc comment survives parsing
  "plugin": ["some-plugin"],
  "default_agent": "lead",
  "subagent_depth": 100,
  "permission": {"*": "allow"},
  "mcp": {
    "local1": {"type": "local", "command": ["npx", "-y", "srv"], "environment": {"API_TOKEN": "supersecret", "MODE": "x"}, "enabled": true},
    "remote1": {"type": "remote", "url": "https://x.test/mcp", "headers": {"Authorization": "{env:TOK}"}},
    "off": {"type": "local", "command": ["x"], "enabled": false},
  },
}
